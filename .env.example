# Names only, never values. Server only: never use a NEXT_PUBLIC_ prefix for any of these.
# Claude writes notes only for synthetic and Photoncar laps. Without a key, notes fall back to code-built templates.
ANTHROPIC_API_KEY=
# Optional. Set NOTES_ENABLED=false to force template notes.
NOTES_ENABLED=
# Optional. Per-instance daily cap in US dollars. Default 0.50.
NOTES_DAILY_SPEND_CAP_USD=
